{
  "name": "rightclips-engine",
  "version": "1.0.0",
  "description": "Automated YouTube Shorts Motion Graphics Engine with Remotion",
  "scripts": {
    "start": "remotion preview",
    "typecheck": "tsc --noEmit",
    "validate": "python3 scripts/validate_clip.py",
    "studio": "node studio/server.js",
    "generate": "python generate_assets.py",
    "render:thumbnails": "node scripts/render_all_thumbnails.js",
    "render:thumbnail": "node scripts/render_all_thumbnails.js"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.240",
    "@remotion/tailwind": "^4.0.240",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "lucide-react": "^0.475.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.240"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
