{
  "name": "rightmotion-engine",
  "version": "1.0.0",
  "description": "RightMotion — AI-Powered Remotion Video Engine",
  "scripts": {
    "start": "remotion preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:studio",
    "test:unit": ".venv/bin/python3 -m unittest discover -s tests/unit -p 'test_*.py'",
    "test:integration": ".venv/bin/python3 -m unittest discover -s tests/integration -p 'test_*.py' && npm run test:causal && npm run test:primitives && npm run test:ast",
    "test:causal": "npx tsx tests/integration/test_causal_engine.ts",
    "test:primitives": "npx tsx tests/integration/test_primitives_render.ts",
    "test:ast": "npx tsx tests/integration/test_ast_player.ts",
    "test:studio": "node tests/studio/test_remote_access.js",
    "validate": "python3 scripts/validate_clip.py",
    "studio": "node studio/server.js",
    "render:thumbnails": "node scripts/render_all_thumbnails.js",
    "render:thumbnail": "node scripts/render_all_thumbnails.js"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.240",
    "@remotion/tailwind": "^4.0.240",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "lucide-react": "^0.475.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.240",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
