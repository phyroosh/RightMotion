# Dependencies
node_modules/

# Secrets & OAuth Credentials (DO NOT COMMIT SENSITIVE TOKENS)
studio/token*.json
studio/client_secrets*.json
studio/instagram_session*.json
studio/credentials/
studio/tokens/
studio/instagram_sessions/
studio/credentials.json
studio/channels.json
studio/instagram_accounts.json
.env
.env.*
*.pem
*.key

# Rendered Video Outputs & Snapshot Dumps (DO NOT PUSH VIDEOS OR PICTURES)
out/*
!out/.gitkeep
out/*.mp4
out/*.png
out/reference/

# Generated Video Metadata & Upload Tracking (Engine only, no video outputs)
studio/metadata.json
studio/uploads.json
studio/pipeline.json

# Generated Audio Voiceovers & Transcripts (Keep public/assets, public/audio, and public/memes)
public/*/*.mp3
public/**/*.mp3
public/*/facecam.mp4
public/**/*.mp4
public/*/tts_temp/
public/**/tts_temp/
!public/memes/
!public/memes/*
!public/memes/*.mp4
!public/memes/registry.json
src/clips/*/transcript.json


# Remotion & Build Artifacts
.remotion/
dist/
build/

